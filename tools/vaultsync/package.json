{
  "name": "vaultsync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PC Obsidian Vault <-> GitHub auto sync (debounced commit+push, periodic fetch+rebase+pull)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "sync": "node src/index.js --once",
    "setup": "node src/setup.js",
    "status": "node src/status.js",
    "gui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File gui.ps1",
    "configure": "node src/setup.js --reconfigure",
    "doctor": "node src/manage.js doctor",
    "build:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-portable.ps1",
    "build:light": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-portable.ps1 -Light",
    "stop": "node src/manage.js stop",
    "pause": "node src/manage.js pause",
    "resume": "node src/manage.js resume",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  }
}
